# Nilai yang dibaca docker-compose.yml. Salin ke .env lalu sesuaikan:
#
#   cp .env.example .env
#
# .env sudah masuk .gitignore. Setiap variabel di sini punya default di
# docker-compose.yml, jadi compose tetap jalan tanpa .env — tapi jangan pakai
# password default di luar mesin sendiri.
#
# Perhatikan bedanya dua kelompok di bawah. POSTGRES_* mengonfigurasi container
# PostgreSQL (dibaca image resminya), sedangkan container aplikasi membaca
# DATABASE_* dan REDIS_* karena viper memetakan setiap kunci config.json ke
# environment variable dengan `.` diganti `_` (database.host -> DATABASE_HOST).
# docker-compose.yml menurunkan DATABASE_* dari POSTGRES_* supaya satu password
# tidak perlu ditulis dua kali.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grand_erp

# Port di HOST yang dipetakan ke PostgreSQL di container.
#
# Defaultnya 5433, bukan 5432, karena mesin ini sudah menjalankan PostgreSQL lokal
# di 5432 — memakai 5432 di sini akan gagal bind dengan "address already in use".
# Di dalam jaringan compose, service lain tetap memakai port 5432.
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6379

# Port di HOST untuk server HTTP.
WEB_HOST_PORT=3000

# Level logrus: 3 warn, 4 info, 5 debug, 6 trace.
LOG_LEVEL=4

# Kunci penanda tangan token. WAJIB, minimal 32 karakter — server menolak start
# tanpa ini, dan tidak ada nilai defaultnya di config.example.json.
#
# Tidak ada default karena kunci default berarti kunci yang sama dipakai setiap
# deployment, dan siapa pun yang memegangnya bisa membuat token SUPERADMIN untuk
# user id mana pun. Nilai di bawah hanya untuk mesin sendiri; ganti sebelum
# dipakai di tempat lain:
#
#   openssl rand -base64 48
JWT_SECRET=ganti-nilai-ini-minimal-32-karakter-untuk-dev-saja

# Umur access token dalam menit. Token JWT itu sendiri tidak bisa dicabut,
# jadi ini adalah jendela sisa setelah sesi dicabut (logout, ganti password,
# is_aktif=false, atau seluruh grant dicabut — isu #24) sebelum pemanggil
# benar-benar kehilangan akses. Sengaja pendek.
JWT_TTL_MINUTES=15

# Umur refresh token dalam menit — ini yang sekarang benar-benar membatasi
# sebuah sesi. Disimpan di Redis dan bisa dicabut langsung; nilai ini hanya
# membatasi umur refresh token yang tidak pernah dipakai/dicabut sama sekali.
# 43200 menit = 30 hari.
JWT_REFRESH_TTL_MINUTES=43200

# Jarak antar sapuan rekonsiliasi rantai saldo kartu_stok (isu #25) — job kedua di
# worker, read-only, yang hanya melapor kalau rantainya menyimpang dari perhitungan
# trigger dan tidak pernah memperbaikinya sendiri. Harian sudah cukup selama
# tabelnya masih kecil; format sama seperti DOKUMEN_CLEANUP_INTERVAL ("24h").
REKONSILIASI_INTERVAL=24h

# Jarak antar sapuan baris presensi yang masih BUKA sejak tanggalnya sudah lewat
# (isu #40 fase 5) — job ketiga di worker, worker-only seperti dua di atas. Baris
# begini adalah orang yang resign, cuti panjang, atau sakit seminggu dan tidak
# pernah menekan tombol pulang lagi; harian sudah cukup karena ini bukan urusan
# real-time.
PRESENSI_SAPUAN_INTERVAL=24h

# OCR faktur/nota pembelian lewat Gemini API (isu #39). Kosong secara default —
# beda dari JWT_SECRET, kosong di sini BUKAN kesalahan konfigurasi: kedua route
# OCR (POST /pembelian/ocr/faktur-kedatangan dan /ocr/nota) hanya tidak
# didaftarkan sama sekali, dan sisa API tetap jalan seperti biasa. Isi dengan
# API key dari https://ai.google.dev/gemini-api/docs/api-key untuk mengaktifkan
# fitur ini. Hanya dibaca web; worker tidak pernah memanggil Gemini.
GEMINI_API_KEY=

# Nama model tetap, bukan alias seperti "gemini-flash-latest" — alias bisa
# berpindah model semalam tanpa jejak commit. Google sudah pernah mempensiunkan
# model tanpa peringatan lain selain menjawab 404 (gemini-2.5-flash, saat isu
# ini ditulis); ganti nilai ini dengan sengaja kalau itu terjadi lagi.
GEMINI_MODEL=gemini-3.6-flash

# Batas waktu satu panggilan ke Gemini, dalam detik.
GEMINI_TIMEOUT_SECONDS=60
