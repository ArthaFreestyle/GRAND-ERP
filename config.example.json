{
  "app": {
    "name": "GRAND-ERP"
  },
  "web": {
    "host": "0.0.0.0",
    "port": 3000,
    "swagger": true
  },
  "log": {
    "level": 6
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5433,
    "username": "postgres",
    "password": "",
    "name": "grand_erp",
    "sslmode": "disable",
    "pool": {
      "idle": 10,
      "max": 100,
      "lifetime_seconds": 300
    }
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "captcha": {
    "ttl_seconds": 300
  },
  "throttle": {
    "login": {
      "max_attempts": 5,
      "window_minutes": 15
    }
  },
  "dokumen": {
    "storage_path": "./data/dokumen",
    "max_size_mb": 10,
    "orphan_ttl_hours": 24,
    "cleanup_interval": "24h"
  },
  "jwt": {
    "secret": "",
    "ttl_minutes": 15,
    "refresh_ttl_minutes": 43200,
    "issuer": "grand-erp"
  }
}
